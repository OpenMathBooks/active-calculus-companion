    <statement><p>Find  <m>f'</m>, given</p>
<p><me>f(x) = \frac{x\sin^{3}\mathopen{}\left(x^{3}\right)}{\sqrt{x^{6}+1}}</me></p>
<p><m>f'( x ) =</m><fillin characters="80" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{\left(\sin^{3}\mathopen{}\left(x^{3}\right)+x\cdot 3\sin^{2}\mathopen{}\left(x^{3}\right)\cdot 3x^{2}\cos\mathopen{}\left(x^{3}\right)\right)\sqrt{x^{6}+1}-x\sin^{3}\mathopen{}\left(x^{3}\right)\frac{1}{2\sqrt{x^{6}+1}}\cdot 6x^{5}}{\left(\sqrt{x^{6}+1}\right)^{2}}</m>
      </p>
    </answer>
