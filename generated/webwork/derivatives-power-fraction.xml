    <statement><p>Find the derivative of 
<m>y=x^{11/12}</m>.</p>
<p><m>{dy\over dx} =</m> <fillin characters="35" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{11}{12}x^{\frac{11}{12}-1}</m>
      </p>
    </answer>
    <solution><me>{dy\over dx} = \frac{11}{12}\cdot x^{(11/12) - 1} = 
  \frac{11}{12}\cdot x^{-1/12}</me>


</solution>
