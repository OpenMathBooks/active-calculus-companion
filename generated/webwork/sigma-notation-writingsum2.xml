    <statement><p>Write the sum in summation notation, using the given
lower bound.</p>
<p><me>\dfrac{1}{2}+\dfrac{2}{3}+\dfrac{3}{4}+\dfrac{4}{5}+\dfrac{5}{6}+\dfrac{6}{7}+\dfrac{7}{8}+\dfrac{8}{9} = \sum_{i=1}^{b} a_i</me>
<m>b =</m><fillin characters="5" name="AnSwEr0001"/>, <m>a_i =</m><fillin characters="10" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>8</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{i}{i+1}</m>
      </p>
    </answer>
    <solution><alert> Solution:</alert> 



<me>\dfrac{1}{2}+\dfrac{2}{3}+\dfrac{3}{4}+\dfrac{4}{5}+\dfrac{5}{6}+\dfrac{6}{7}+\dfrac{7}{8}+\dfrac{8}{9}</me>
<me>= \dfrac{1}{1+1} + \dfrac{2}{2 + 1} + \cdots + 
  \dfrac{8}{8 + 1}
  = \sum_{i=1}^{8} \dfrac{i}{i+1}</me>


</solution>
