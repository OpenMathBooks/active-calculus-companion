    <statement><p>Select <alert>all</alert> expressions that are equivalent to  
<me>\displaystyle y + \frac{y}{4} + \frac{4}{y}.</me>  
There may be more than one correct answer.</p>
<p><var form="checkboxes">
<li>
<p><m>\displaystyle \frac{5 y}{4} + \frac{4}{y}</m></p>
</li>
<li>
<p><m>\displaystyle \frac{y^2 + 16}{4 y }</m></p>
</li>
<li>
<p><m>\displaystyle \frac{2y + 4}{4 + y}</m></p>
</li>
<li>
<p><m>\displaystyle y + 4</m></p>
</li>
<li>
<p><m>\displaystyle \frac{5 y^2 + 16}{4 y}</m></p>
</li>
</var></p>
</statement>
