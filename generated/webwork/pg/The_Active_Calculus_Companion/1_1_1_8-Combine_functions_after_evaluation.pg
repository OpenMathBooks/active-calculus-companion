## DESCRIPTION
## Algebra and Number Theory
## ENDDESCRIPTION

## Tagged by XW

## DBsubject(Algebra)
## DBchapter(Functions)
## DBsection(Function notation)
## Institution(ASU)
## MLT(CombineFcns)
## Level(2)
## KEYWORDS('algebra', 'functions', 'function evaluation', 'definition of function')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;
$a = non_zero_random(2,9,1);
$b = non_zero_random(-9,9,1);
#$b = ($b == 0)? 1: $b;
$sign = ($b > 0)? "+": "";

BEGIN_PGML
Given the function [` f(x)= [$a] x^2 [$sign][$b] `], evaluate the
following expressions:


[`f(x + 2)= `] [_________________]


[`f(x) + f(2) = `] [________________]
END_PGML

$ans1 = "$a*(x + 2)**2 + $b";
$ans2 = "$a*(x)**2+$b + $a * 4 + $b";
ANS(fun_cmp($ans1, var=>'x'));
ANS(fun_cmp($ans2, var=>'x'));

ENDDOCUMENT();        # This should be the last executable line in the problem.

