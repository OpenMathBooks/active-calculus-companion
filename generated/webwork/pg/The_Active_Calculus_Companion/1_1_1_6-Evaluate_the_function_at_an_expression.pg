DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGML.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$a = random(1,20,1);
$b = - random(3,20,1);

$ans1 = ($a - 2)/($b + 2);
$ans2 = ($a + 2)/($b - 2);
$ans3 = ($a - 1/2)/($b + 1/2);
$ans4 = "($a - a)/($b + a)";
$ans5 = "($a - (a - 1))/($b + a - 1)";
#$ans6 = 1/0;
ANS(num_cmp($ans1));
ANS(num_cmp($ans2));
ANS(num_cmp($ans3));
ANS(fun_cmp($ans4, var=>'a'));
ANS(fun_cmp($ans5, var=>'a'));
#ANS(num_cmp($ans6));

BEGIN_PGML
Evaluate the function [`f(x)=\frac{[$a]-x}{[$b]+x}`] at the indicated values:

[`f(2)=`] [________]

[`f(-2)=`] [________]

[`f(\frac{1}{2})=`] [________]

[`f(a)=`] [________________]

[`f(a - 1)=`] [________________]
END_PGML


ENDDOCUMENT();        # This should be the last executable line in the problem.
