    <statement><p>Let <m>f(x) = \displaystyle \frac{3x^{2}\tan\mathopen{}\left(x\right)}{\sec\mathopen{}\left(x\right)}</m>.  Find the following:</p>
<tabular>
<row>
<cell>1.</cell>
<cell><m>f'(x)</m></cell>
<cell><m>=</m></cell>
<cell><fillin characters="80" name="AnSwEr0001"/></cell>
</row>
<row>
<cell>2.</cell>
<cell><m>f'(2)</m></cell>
<cell><m>=</m></cell>
<cell><fillin characters="80" name="AnSwEr0002"/></cell>
</row>
</tabular>
</statement>
    <answer>
      <p>
        <m>\frac{\left(6x\tan\mathopen{}\left(x\right)+3x^{2}\sec^{2}\mathopen{}\left(x\right)\right)\sec\mathopen{}\left(x\right)-3x^{2}\tan\mathopen{}\left(x\right)\sec\mathopen{}\left(x\right)\tan\mathopen{}\left(x\right)}{\sec^{2}\mathopen{}\left(x\right)}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>5.91781</m>
      </p>
    </answer>
