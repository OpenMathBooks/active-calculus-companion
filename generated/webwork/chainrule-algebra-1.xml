    <statement><p>Given the following functions: <m>f(u)=u^{7/2}</m> and <m>g(x)=x^{8}+1</m>. Find:</p>
<p><m>f(g(x))=</m> <fillin characters="20" name="AnSwEr0001"/></p>
<p><m>f'(u)=</m> <fillin characters="20" name="AnSwEr0002"/></p>
<p><m>f'(g(x))=</m> <fillin characters="20" name="AnSwEr0003"/></p>
<p><m>g'(x)=</m> <fillin characters="20" name="AnSwEr0004"/></p>
<p><m>(f\circ g)'(x)=</m> <fillin characters="20" name="AnSwEr0005"/></p>
</statement>
    <answer>
      <p>
        <m>\left(x^{8}+1\right)^{\frac{7}{2}}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{7}{2}u^{\frac{7}{2}-1}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{7}{2}\mathopen{}\left(x^{8}+1\right)^{\frac{7}{2}-1}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>8x^{8-1}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{7}{2}\mathopen{}\left(x^{8}+1\right)^{\frac{7}{2}-1}\cdot 8x^{8-1}</m>
      </p>
    </answer>
