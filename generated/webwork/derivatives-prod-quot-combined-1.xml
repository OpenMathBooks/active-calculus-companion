    <statement><p>Find <m>f'(x)</m> for <me>f(x)=\frac{10\sin\mathopen{}\left(x\right)}{2x^{2}+10\sin\mathopen{}\left(x\right)}</me></p>
<p><m>f'(x)  =</m> <fillin characters="60" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{20x^{2}\cos\mathopen{}\left(x\right)-40x\sin\mathopen{}\left(x\right)}{\left(2x^{2}+10\sin\mathopen{}\left(x\right)\right)^{2}}</m>
      </p>
    </answer>
    <solution><me>f'(x)=\frac{d}{dx}\left(\frac{10\sin\mathopen{}\left(x\right)}{2x^{2}+10\sin\mathopen{}\left(x\right)}\right)=\frac{10\cos\mathopen{}\left(x\right)\mathopen{}\left(2x^{2}+10\sin\mathopen{}\left(x\right)\right)-10\sin\mathopen{}\left(x\right)\mathopen{}\left(4x+10\cos\mathopen{}\left(x\right)\right)}{\left(2x^{2}+10\sin\mathopen{}\left(x\right)\right)^{2}}=\frac{20x^{2}\cos\mathopen{}\left(x\right)-40x\sin\mathopen{}\left(x\right)}{\left(2x^{2}+10\sin\mathopen{}\left(x\right)\right)^{2}}</me>
or
<me>f'(x)=\frac{20 x[x \cos(x)-2 \sin(x)]}{[2 x^2 +10 \sin(x)]^2}</me>


</solution>
