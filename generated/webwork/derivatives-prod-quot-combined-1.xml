    <statement><p>Find <m>f'(x)</m> for <me>f(x)=\frac{18\sin\mathopen{}\left(x\right)}{5x^{2}+18\sin\mathopen{}\left(x\right)}</me></p>
<p><m>f'(x)  =</m> <fillin characters="60" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{90x^{2}\cos\mathopen{}\left(x\right)-180x\sin\mathopen{}\left(x\right)}{\left(5x^{2}+18\sin\mathopen{}\left(x\right)\right)^{2}}</m>
      </p>
    </answer>
    <solution><me>f'(x)=\frac{d}{dx}\left(\frac{18\sin\mathopen{}\left(x\right)}{5x^{2}+18\sin\mathopen{}\left(x\right)}\right)=\frac{18\cos\mathopen{}\left(x\right)\mathopen{}\left(5x^{2}+18\sin\mathopen{}\left(x\right)\right)-18\sin\mathopen{}\left(x\right)\mathopen{}\left(10x+18\cos\mathopen{}\left(x\right)\right)}{\left(5x^{2}+18\sin\mathopen{}\left(x\right)\right)^{2}}=\frac{90x^{2}\cos\mathopen{}\left(x\right)-180x\sin\mathopen{}\left(x\right)}{\left(5x^{2}+18\sin\mathopen{}\left(x\right)\right)^{2}}</me>
or
<me>f'(x)=\frac{90 x[x \cos(x)-2 \sin(x)]}{[5 x^2 +18 \sin(x)]^2}</me>


</solution>
