    <statement><p>If <m>f(x)=\sqrt{x}\sin{x}</m>, find <m>f'(x)</m>.</p>
<p><m>f'(x) =</m> <fillin characters="50" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>x^{\frac{1}{2}}\cos\mathopen{}\left(x\right)+\frac{1}{2}x^{\frac{-1}{2}}\sin\mathopen{}\left(x\right)</m>
      </p>
    </answer>
