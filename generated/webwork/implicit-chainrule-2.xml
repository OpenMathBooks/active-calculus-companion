    <statement><p>Compute implicit derivatives of the following expressions</p>
<p>Write <m>y'</m> for <m>\frac{dy}{dx}</m>.</p>
<p><alert> A.</alert> <m>\quad \frac{d}{dx} \displaystyle \Biggl[\;ye^{x}\;\Biggr] =</m>
<fillin characters="20" name="AnSwEr0001"/></p>
<p><alert> B.</alert> <m>\quad \frac{d}{dx} \displaystyle \Biggl[\;x\ln\mathopen{}\left(y\right)\;\Biggr] =</m>
<fillin characters="20" name="AnSwEr0002"/></p>
<p><alert> C.</alert> <m>\quad \frac{d}{dx} \displaystyle \Biggl[\;e^{x+y}\;\Biggr] =</m>
<fillin characters="20" name="AnSwEr0003"/></p>
<p><alert> D.</alert> <m>\quad \frac{d}{dx} \displaystyle \Biggl[\;e^{xy}\;\Biggr] =</m>
<fillin characters="20" name="AnSwEr0004"/></p>
<p><alert> E.</alert> <m>\quad \frac{d}{dx} \displaystyle \Biggl[\;\ln\mathopen{}\left(x+y\right)\;\Biggr] =</m>
<fillin characters="20" name="AnSwEr0005"/></p>
<p><alert> F.</alert> <m>\quad \frac{d}{dx} \displaystyle \Biggl[\;\ln\mathopen{}\left(xy\right)\;\Biggr] =</m>
<fillin characters="20" name="AnSwEr0006"/></p>
</statement>
    <answer>
      <p>
        <m>y'e^{x}+ye^{x}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\ln\mathopen{}\left(y\right)+x\frac{y'}{y}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left(1+y'\right)e^{x+y}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left(y+xy'\right)e^{xy}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{1+y'}{x+y}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{y+xy'}{xy}</m>
      </p>
    </answer>
