at <m>x = 10</m>.</p>
<p>Tangent line: <m>y</m> = <fillin characters="40" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>0.00628698\mathopen{}\left(x-10\right)+0.134615</m>
      </p>
    </answer>
