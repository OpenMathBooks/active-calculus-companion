    <statement><p>If 
<me>f(x) = \frac { 3 \sin x }{ 1 + \cos x }</me>
find <m>f'( x )</m>.</p>
<p>Answer:  <fillin characters="50" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{3\cos\mathopen{}\left(x\right)\cdot 1+3}{\left(1+\cos\mathopen{}\left(x\right)\right)^{2}}</m>
      </p>
    </answer>
